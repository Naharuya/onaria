+import 'dart:convert';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:onaria/features/signup_page.dart';
+import 'package:onaria/src/api/member_api_client.dart';
+import 'package:onaria/app/member_session_store.dart';
+import 'package:shared_preferences_platform_interface/in_memory_shared_preferences_async.dart';
+import 'package:shared_preferences_platform_interface/shared_preferences_async_platform_interface.dart';
+
+void main() {
+  setUp(() {
+    SharedPreferencesAsyncPlatform.instance = InMemorySharedPreferencesAsync.empty();
+    MemberSessionStore.instance.clear();
+  });
+  tearDown(() { MemberSessionStore.instance.clear(); });
+  Future<void> open(WidgetTester tester, Future<http.Response> Function(http.Request) handler) async {
+    await tester.pumpWidget(MaterialApp(home: Builder(builder: (context) => Scaffold(body: TextButton(
+      onPressed: () => Navigator.of(context).push(MaterialPageRoute<void>(builder: (_) => SignUpPage(
+        credentialLoader: (provider) async => 'proof-$provider',
+        memberClientFactory: () => MemberApiClient(baseUrl: Uri.parse('https://api.onaria.ai.kr'), httpClient: MockClient(handler)),
+      ))), child: const Text('시작'))))));
+    await tester.tap(find.text('시작')); await tester.pumpAndSettle();
+  }
+  http.Response unknown() => http.Response(jsonEncode({'code':'PROVIDER_IDENTITY_NOT_FOUND','message':'unknown'}),404);
+  Future<void> tap(WidgetTester tester,String label) async {
+    if (find.text(label).evaluate().isEmpty) { await tester.scrollUntilVisible(find.text(label), 180); }
+    await tester.ensureVisible(find.text(label)); await tester.pumpAndSettle(); await tester.tap(find.text(label)); await tester.pumpAndSettle();
+  }
+  testWidgets('unknown identity offers choice before optional signup fields', (tester) async {
+    await tester.binding.setSurfaceSize(const Size(800,1200));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    await open(tester, (_) async => unknown());
+    await tap(tester,'네이버로 계속하기');
+    await tester.scrollUntilVisible(find.text('기존 ONARIA 계정에 연결'),180);
+    expect(find.text('기존 ONARIA 계정에 연결'), findsOneWidget);
+    expect(find.text('이름 (선택)'),findsNothing);
+    await tap(tester,'새 계정 만들기');
+    await tester.scrollUntilVisible(find.text('이름 (선택)'),180,scrollable:find.byType(Scrollable).first);
+    expect(find.text('이름 (선택)'),findsOneWidget);
+  });
+  testWidgets('failed existing proof preserves pending credential; successful retry stores linked session', (tester) async {
+    await tester.binding.setSurfaceSize(const Size(800,1200));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    var attempts=0;
+    await open(tester,(request) async {
+      final body=jsonDecode(request.body) as Map<String,dynamic>;
+      if(request.url.path.endsWith('/session')) {
+        if(body['provider']=='naver') return unknown();
+        if(++attempts==1) return unknown();
+        return http.Response(jsonEncode({'sessionToken':'A'*43,'expiresInSeconds':3600}),201);
+      }
+      expect(request.url.path,'/v1/account/providers');
+      expect(body,{'provider':'naver','credential':'proof-naver'});
+      expect(request.headers['X-Onaria-Member-Session'],'A'*43);
+      return http.Response(jsonEncode({'member':{'id':7},'sessionToken':'B'*43,'expiresInSeconds':3600}),200);
+    });
+    await tap(tester,'네이버로 계속하기'); await tap(tester,'기존 ONARIA 계정에 연결');
+    expect(find.text('기존 ONARIA 계정으로 본인 확인'),findsOneWidget);
+    await tap(tester,'Google로 계속하기');
+    expect(find.text('기존 ONARIA 계정으로 본인 확인'),findsOneWidget);
+    expect(MemberSessionStore.instance.token,isNull);
+    await tap(tester,'Google로 계속하기');
+    expect(MemberSessionStore.instance.token,'B'*43);
+    expect(find.text('시작'),findsOneWidget);
+  });
+  testWidgets('unrelated 404 never enables signup and small screen keeps provider order', (tester) async {
+    tester.view.physicalSize=const Size(320,568);tester.view.devicePixelRatio=1;
+    addTearDown(tester.view.resetPhysicalSize);addTearDown(tester.view.resetDevicePixelRatio);
+    await open(tester,(_) async => http.Response('{"code":"ROUTE_NOT_FOUND","message":"failed"}',404));
+    await tap(tester,'네이버로 계속하기');
+    expect(find.text('새 계정 만들기'),findsNothing);
+    expect(tester.takeException(),isNull);
+    final apple=tester.getTopLeft(find.byKey(const ValueKey('apple-signup'))).dy;
+    final google=tester.getTopLeft(find.byKey(const ValueKey('google-signup'))).dy;
+    expect(apple,lessThan(google));
+  });
+}
