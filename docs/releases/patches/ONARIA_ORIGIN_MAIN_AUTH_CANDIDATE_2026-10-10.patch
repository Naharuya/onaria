+test('실제 FK cascade 실패는 전체 rollback, 해소 후 재시도는 다른 owner call 보존',()=>{
+ const root=fs.mkdtempSync(path.join(os.tmpdir(),'onaria-deletion-'));const filename=path.join(root,'cost.sqlite');let ledger,db;
+ try{
