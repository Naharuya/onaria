@@ -0,0 +1,73 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+import 'package:onaria/app/member_auth_controller.dart';
+import 'package:onaria/app/member_session_store.dart';
+import 'package:onaria/features/account_menu.dart';
+import 'package:onaria/src/api/provider_auth_api_client.dart';
+
+import 'member_auth_controller_test.dart' show AuthMemoryPersistence;
+
+void main() {
+  setUp(() => PackageInfo.setMockInitialValues(
+        appName: 'ONARIA',
+        packageName: 'com.onaria.app',
+        version: '1.2.3',
+        buildNumber: '987',
+        buildSignature: '',
+      ));
+  testWidgets('live menu checks session then exposes logout without deletion',
+      (tester) async {
+    final store = MemberSessionStore.forTesting(AuthMemoryPersistence());
+    store.set(token: 'A' * 43, expiresInSeconds: 3600);
+    final account = Completer<http.Response>();
+    final deletes = <String>[];
+    final auth = MemberAuthController(
+      sessions: store,
+      signOutNaver: () async {},
+      clientFactory: () => ProviderAuthApiClient(
+          baseUrl: Uri.parse('https://api.onaria.ai.kr'),
+          httpClient: MockClient((request) async {
+            if (request.method == 'DELETE') {
+              deletes.add(request.url.path);
+              return http.Response('', 204);
+            }
+            return account.future;
+          })),
+    );
+    addTearDown(auth.dispose);
+    addTearDown(store.dispose);
+    await tester.pumpWidget(
+        MaterialApp(home: Scaffold(body: AccountMenuButton(controller: auth))));
+    await tester.tap(find.byTooltip('메뉴'));
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(find.text('확인 중'), findsOneWidget);
+    expect(find.text('로그인됨 · 네이버'), findsNothing);
+    account.complete(http.Response(
+        '{"providers":["naver","apple"],"currentProvider":"naver"}', 200));
+    await tester.pumpAndSettle();
+    expect(find.text('로그인됨 · 네이버'), findsOneWidget);
+    expect(find.text('계정 관리'), findsOneWidget);
+    await tester.scrollUntilVisible(
+        find.byKey(const ValueKey('menu-app-info')), 250);
+    await tester.pumpAndSettle();
+    expect(find.text('앱 정보'), findsOneWidget);
+    expect(find.text('버전 1.2.3 · 빌드 987'), findsOneWidget);
+    await tester.scrollUntilVisible(
+        find.byKey(const ValueKey('menu-logout')), -250);
+    expect(find.text('회원탈퇴'), findsNothing);
+    await tester.tap(find.byKey(const ValueKey('menu-logout')));
+    await tester.pumpAndSettle();
+    expect(deletes, ['/v1/auth/provider/session']);
+    await tester.scrollUntilVisible(
+        find.byKey(const ValueKey('menu-auth-status')), -250);
+    await tester.pumpAndSettle();
+    expect(find.text('로그인하지 않음'), findsOneWidget);
+    expect(find.byKey(const ValueKey('menu-login')), findsOneWidget);
+    expect(find.byKey(const ValueKey('menu-logout')), findsNothing);
+  });
+}
diff --git a/test/auth_diagnostics_test.dart b/test/auth_diagnostics_test.dart
new file mode 100644
index 0000000..c9cd31c
--- /dev/null
+++ b/test/auth_diagnostics_test.dart
@@ -0,0 +1,126 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:onaria/src/api/auth_diagnostics.dart';
+import 'package:onaria/src/api/member_api_client.dart';
+import 'package:onaria/src/api/provider_auth_api_client.dart';
+
+void main() {
+  test('failure diagnostics allow fixed reasons only', () {
+    final previous = debugPrint;
+    final events = <String>[];
+    debugPrint = (message, {wrapWidth}) {
+      if (message != null) events.add(message);
+    };
+    try {
+      AuthDiagnostics.failure('GET', '/v1/account', 'private-error');
+      AuthDiagnostics.failure('GET', '/v1/account?private', 'timeout');
+      expect(events, isEmpty);
+      AuthDiagnostics.failure('GET', '/v1/account', 'timeout');
+      expect(
+          events,
+          AuthDiagnostics.enabled
+              ? ['ONARIA_AUTH_STATUS operation=account failure=timeout']
+              : isEmpty);
+    } finally {
+      debugPrint = previous;
+    }
+  });
+  test('temporary diagnostic export is bounded and rejects secret content',
+      () async {
+    final directory =
+        await Directory.systemTemp.createTemp('onaria-diag-test-');
+    addTearDown(() => directory.delete(recursive: true));
+    final file = File('${directory.path}/status.log');
+    await AuthDiagnostics.persistTo(file, 'private-proof');
+    expect(await file.exists(), isFalse);
+    await file.writeAsString('private-response\n');
+    for (var i = 0; i < 66; i++) {
+      await AuthDiagnostics.persistTo(
+          file, 'ONARIA_AUTH_STATUS operation=account status=200');
+    }
+    final lines = await file.readAsLines();
+    expect(lines, hasLength(64));
+    expect(
+        lines.every((line) =>
+            line == 'ONARIA_AUTH_STATUS operation=account status=200'),
+        isTrue);
+    await AuthDiagnostics.persistTo(file,
+        'ONARIA_AUTH_STATUS operation=account status=200 credential=private');
+    expect(await file.readAsLines(), lines);
+  });
+  late List<String> events;
+  late DebugPrintCallback previous;
+
+  setUp(() {
+    events = [];
+    previous = debugPrint;
+    debugPrint = (message, {wrapWidth}) {
+      if (message != null) events.add(message);
+    };
+  });
+  tearDown(() => debugPrint = previous);
+
+  test('login and logout record only fixed operation and HTTP status',
+      () async {
+    final member = MemberApiClient(
+      baseUrl: Uri.parse('https://api.onaria.ai.kr'),
+      httpClient: MockClient((_) async => http.Response(
+          jsonEncode({
+            'sessionToken': 'A' * 43,
+            'expiresInSeconds': 900,
+          }),
+          201)),
+    );
+    final provider = ProviderAuthApiClient(
+      baseUrl: Uri.parse('https://api.onaria.ai.kr'),
+      httpClient: MockClient((_) async => http.Response('', 204)),
+    );
+    addTearDown(member.close);
+    addTearDown(provider.close);
+    await member.providerSession(
+        provider: 'naver', credential: 'private-proof');
+    await provider.logout('private-session');
+    expect(
+        events,
+        AuthDiagnostics.enabled
+            ? [
+                'ONARIA_AUTH_STATUS operation=login status=201',
+                'ONARIA_AUTH_STATUS operation=logout status=204',
+              ]
+            : isEmpty);
+  });
+
+  test('rejected login records 401 without response error or credential',
+      () async {
+    final client = MemberApiClient(
+      baseUrl: Uri.parse('https://api.onaria.ai.kr'),
+      httpClient: MockClient((_) async =>
+          http.Response(jsonEncode({'message': 'private-response'}), 401)),
+    );
+    addTearDown(client.close);
+    await expectLater(
+      client.providerSession(provider: 'naver', credential: 'private-proof'),
+      throwsA(isA<MemberApiException>()),
+    );
+    expect(
+        events,
+        AuthDiagnostics.enabled
+            ? [
+                'ONARIA_AUTH_STATUS operation=login status=401',
+              ]
+            : isEmpty);
+  });
+
+  test('unknown paths, query strings and invalid statuses cannot be logged',
+      () {
+    AuthDiagnostics.record('GET', '/v1/account?credential=private', 200);
+    AuthDiagnostics.record('POST', '/unknown/private', 200);
+    AuthDiagnostics.record('POST', '/v1/auth/provider/session', 999);
+    expect(events, isEmpty);
+  });
+}
diff --git a/test/member_auth_controller_test.dart b/test/member_auth_controller_test.dart
new file mode 100644
index 0000000..c3f28e1
--- /dev/null
+++ b/test/member_auth_controller_test.dart
@@ -0,0 +1,173 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:onaria/app/member_auth_controller.dart';
+import 'package:onaria/app/member_session_store.dart';
+import 'package:onaria/src/api/provider_auth_api_client.dart';
+
+class AuthMemoryPersistence implements MemberSessionPersistence {
+  final values = <String, String>{};
+  @override
+  Future<String?> read(String key) async => values[key];
+  @override
+  Future<void> write(String key, String value) async => values[key] = value;
+  @override
+  Future<void> delete(String key) async => values.remove(key);
+}
+
+class FailingAuthPersistence extends AuthMemoryPersistence {
+  bool failing = true;
+  @override
+  Future<String?> read(String key) async {
+    if (failing) throw StateError('secure storage unavailable');
+    return super.read(key);
+  }
+}
+
+void main() {
+  test('account timeout ends checking, preserves session and retry recovers',
+      () async {
+    final store = MemberSessionStore.forTesting(AuthMemoryPersistence());
+    store.set(token: 'A' * 43, expiresInSeconds: 3600);
+    var responding = false;
+    final pending = Completer<http.Response>();
+    final auth = MemberAuthController(
+      sessions: store,
+      clientFactory: () => ProviderAuthApiClient(
+        baseUrl: Uri.parse('https://api.onaria.ai.kr'),
+        timeout: const Duration(milliseconds: 20),
+        httpClient: MockClient((_) async => responding
+            ? http.Response(
+                '{"providers":["naver"],"currentProvider":"naver"}', 200)
+            : pending.future),
+      ),
+    );
+    addTearDown(auth.dispose);
+    addTearDown(store.dispose);
+    final check = auth.refresh();
+    expect(auth.label, '확인 중');
+    await check;
+    expect(auth.label, '로그인 상태 확인 불가');
+    expect(store.token, 'A' * 43);
+    responding = true;
+    await auth.retry();
+    expect(auth.label, '로그인됨 · 네이버');
+    expect(store.token, 'A' * 43);
+    pending.complete(http.Response('{}', 503));
+  });
+  MemberAuthController controller(MemberSessionStore store,
+      Future<http.Response> Function(http.Request) handler) {
+    final value = MemberAuthController(
+      sessions: store,
+      signOutNaver: () async {},
+      clientFactory: () => ProviderAuthApiClient(
+          baseUrl: Uri.parse('https://api.onaria.ai.kr'),
+          httpClient: MockClient(handler)),
+    );
+    addTearDown(value.dispose);
+    addTearDown(store.dispose);
+    return value;
+  }
+
+  for (final provider in ['naver', 'google', 'apple', 'kakao']) {
+    test('verified session reports current provider $provider', () async {
+      final store = MemberSessionStore.forTesting(AuthMemoryPersistence());
+      store.set(token: 'A' * 43, expiresInSeconds: 3600);
+      final auth = controller(
+          store,
+          (_) async => http.Response(
+              jsonEncode({
+                'providers': [provider],
+                'currentProvider': provider,
+              }),
+              200));
+      await auth.refresh();
+      expect(auth.state, MemberAuthState.signedIn);
+      expect(auth.provider, provider);
+      expect(
+          auth.label,
+          {
+            'naver': '로그인됨 · 네이버',
+            'google': '로그인됨 · Google',
+            'apple': '로그인됨 · Apple',
+            'kakao': '로그인됨 · 카카오',
+          }[provider]);
+    });
+  }
+
+  test('401 clears only stale session; temporary failure preserves it',
+      () async {
+    final persistence = AuthMemoryPersistence();
+    final store = MemberSessionStore.forTesting(persistence);
+    store.set(token: 'A' * 43, expiresInSeconds: 3600);
+    var status = 503;
+    final auth = controller(store, (_) async => http.Response('{}', status));
+    await auth.refresh();
+    expect(auth.state, MemberAuthState.unavailable);
+    expect(store.token, 'A' * 43);
+    status = 401;
+    await auth.refresh();
+    expect(auth.state, MemberAuthState.signedOut);
+    expect(store.token, isNull);
+  });
+
+  test('late 401 from an older session cannot erase a new login', () async {
+    final store = MemberSessionStore.forTesting(AuthMemoryPersistence());
+    store.set(token: 'A' * 43, expiresInSeconds: 3600);
+    final pending = Completer<http.Response>();
+    final auth = controller(store, (request) async {
+      if (request.headers['X-Onaria-Member-Session'] == 'A' * 43) {
+        return pending.future;
+      }
+      return http.Response(
+          '{"providers":["google"],"currentProvider":"google"}', 200);
+    });
+    final old = auth.refresh();
+    expect(auth.label, '확인 중');
+    store.set(token: 'B' * 43, expiresInSeconds: 3600);
+    await Future<void>.delayed(Duration.zero);
+    pending.complete(http.Response('{}', 401));
+    await old;
+    expect(store.token, 'B' * 43);
+    expect(auth.label, '로그인됨 · Google');
+  });
+
+  test('failed logout retains session; successful logout removes it', () async {
+    final store = MemberSessionStore.forTesting(AuthMemoryPersistence());
+    store.set(token: 'A' * 43, expiresInSeconds: 3600);
+    var logoutStatus = 503;
+    final auth = controller(
+        store,
+        (request) async => request.method == 'DELETE'
+            ? http.Response('{}', logoutStatus)
+            : http.Response(
+                '{"providers":["naver"],"currentProvider":"naver"}', 200));
+    await auth.refresh();
+    await expectLater(auth.logout(), throwsA(isA<ProviderAuthApiException>()));
+    expect(store.token, isNotNull);
+    logoutStatus = 204;
+    expect(await auth.logout(), isTrue);
+    expect(store.token, isNull);
+    expect(auth.label, '로그인하지 않음');
+  });
+
+  test('secure storage failure is unknown until restoration retry succeeds',
+      () async {
+    final persistence = FailingAuthPersistence();
+    final store = MemberSessionStore.forTesting(persistence);
+    store.set(token: 'A' * 43, expiresInSeconds: 3600);
+    await store.restore();
+    final auth = controller(
+        store,
+        (_) async => http.Response(
+            '{"providers":["apple"],"currentProvider":"apple"}', 200));
+    await auth.refresh();
+    expect(auth.state, MemberAuthState.unavailable);
+    persistence.failing = false;
+    await auth.retry();
+    expect(auth.label, '로그인됨 · Apple');
+  });
+}
