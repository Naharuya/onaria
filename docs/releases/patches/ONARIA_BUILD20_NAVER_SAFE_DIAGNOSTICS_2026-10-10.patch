+
+// Never expose the native message: it may include provider payloads or secrets.
+String safeNaverSdkErrorCode(String? message, {bool loggedOut = false}) {
+  if (loggedOut) return 'logged_out';
+  if ((message ?? '').startsWith('Failed to parse user info:')) return 'profile_response_invalid';
+  if ((message ?? '').startsWith('Failed to get user info:')) return 'profile_request_failed';
+  if ((message ?? '').startsWith('SDK not initialized.')) return 'sdk_not_initialized';
+  final match = RegExp(r'(?:errorCode|error_code)\s*[:=]\s*([A-Za-z0-9_-]+)', caseSensitive: false)
+      .firstMatch(message ?? '');
+  final code = match?.group(1)?.toLowerCase();
+  const allowed = {'invalid_client', 'unauthorized_client', 'invalid_request',
+    'invalid_grant', 'invalid_token', 'access_denied', 'user_cancel',
+    '400', '401', '403', '404', '408', '429', '500', '502', '503', '504'};
+  return allowed.contains(code) ? code! : 'unknown';
+}
