[Unit]
Description=ONARIA retention maintenance (14-day backups, expired sessions, 62-day usage)
After=onaria-backup.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/onaria/backend
Environment=ONARIA_DATA_DIR=/opt/onaria/backend/data
Environment=ONARIA_BACKUP_DIR=/opt/onaria-periodic-backups
ExecStart=/usr/bin/node /opt/onaria/backend/scripts/retention_maintenance.js --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/onaria/backend/data /opt/onaria-periodic-backups
