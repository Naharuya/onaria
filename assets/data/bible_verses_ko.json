  "verses": [
    {
      "id": "PHP_4_6_7",
      "book": "빌립보서",
      "chapter": 4,
      "verseStart": 6,
      "verseEnd": 7,
      "reference": "빌립보서 4:6-7",
      "translation": "KRV",
      "text": "아무 것도 염려하지 말고 오직 모든 일에 기도와 간구로, 너희 구할 것을 감사함으로 하나님께 아뢰라 그리하면 모든 지각에 뛰어난 하나님의 평강이 그리스도 예수 안에서 너희 마음과 생각을 지키시리라",
      "englishText": "In nothing be anxious, but in everything, by prayer and petition with thanksgiving, let your requests be made known to God. And the peace of God, which surpasses all understanding, will guard your hearts and your thoughts in Christ Jesus.",
      "emotions": [
        "불안",
        "공포",
        "놀람"
      ],
      "tags": [
        "염려",
        "평안",
        "기도",
        "맡김"
      ],
      "reflectionQuestion": "지금 하나님께 맡기고 싶은 걱정은 무엇인가요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=php&chap=4"
    },
    {
      "id": "ISA_41_10",
      "book": "이사야",
      "chapter": 41,
      "verseStart": 10,
      "verseEnd": null,
      "reference": "이사야 41:10",
      "translation": "KRV",
      "text": "두려워 말라 내가 너와 함께 함이니라 놀라지 말라 나는 네 하나님이 됨이니라 내가 너를 굳세게 하리라 참으로 너를 도와 주리라 참으로 나의 의로운 오른손으로 너를 붙들리라",
      "englishText": "Don’t you be afraid, for I am with you. Don’t be dismayed, for I am your God. I will strengthen you. Yes, I will help you. Yes, I will uphold you with the right hand of my righteousness.",
      "emotions": [
        "불안",
        "외로움",
        "공포"
      ],
      "tags": [
        "두려움",
        "함께함",
        "도움",
        "보호"
      ],
      "reflectionQuestion": "지금 가장 도움이 필요하다고 느끼는 부분은 무엇인가요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=isa&chap=41"
    },
    {
      "id": "PSA_23_4",
      "book": "시편",
      "chapter": 23,
      "verseStart": 4,
      "verseEnd": null,
      "reference": "시편 23:4",
      "translation": "KRV",
      "text": "내가 사망의 음침한 골짜기로 다닐찌라도 해를 두려워하지 않을 것은 주께서 나와 함께 하심이라 주의 지팡이와 막대기가 나를 안위하시나이다",
      "englishText": "Even though I walk through the valley of the shadow of death, I will fear no evil, for you are with me. Your rod and your staff, they comfort me.",
      "emotions": [
        "외로움",
        "슬픔",
        "공포"
      ],
      "tags": [
        "동행",
        "보호",
        "위로"
      ],
      "reflectionQuestion": "혼자가 아니라고 느끼게 해줄 사람이나 기억이 있나요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=psa&chap=23"
    },
    {
      "id": "HEB_13_5",
      "book": "히브리서",
      "chapter": 13,
      "verseStart": 5,
      "verseEnd": null,
      "reference": "히브리서 13:5",
      "translation": "KRV",
      "text": "돈을 사랑치 말고 있는 바를 족한 줄로 알라 그가 친히 말씀하시기를 내가 과연 너희를 버리지 아니하고 과연 너희를 떠나지 아니하리라 하셨느니라",
      "englishText": "Be free from the love of money, content with such things as you have, for he has said, “I will in no way leave you, neither will I in any way forsake you.”",
      "emotions": [
        "외로움"
      ],
      "tags": [
        "버리지않음",
        "함께함",
        "신실함"
      ],
      "reflectionQuestion": "이 말씀을 읽으며 떠오르는 관계가 있나요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=heb&chap=13"
    },
    {
      "id": "MAT_11_28",
      "book": "마태복음",
      "chapter": 11,
      "verseStart": 28,
      "verseEnd": null,
      "reference": "마태복음 11:28",
      "translation": "KRV",
      "text": "수고하고 무거운 짐진 자들아 다 내게로 오라 내가 너희를 쉬게 하리라",
      "englishText": "“Come to me, all you who labor and are heavily burdened, and I will give you rest.",
      "emotions": [
        "지침",
        "슬픔"
      ],
      "tags": [
        "쉼",
        "무거운짐",
        "회복"
      ],
      "reflectionQuestion": "지금 잠시 내려놓아도 되는 짐은 무엇인가요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=mat&chap=11"
    },
    {
      "id": "ISA_40_31",
      "book": "이사야",
      "chapter": 40,
      "verseStart": 31,
      "verseEnd": null,
      "reference": "이사야 40:31",
      "translation": "KRV",
      "text": "오직 여호와를 앙망하는 자는 새 힘을 얻으리니 독수리의 날개치며 올라감 같을 것이요 달음박질하여도 곤비치 아니하겠고 걸어가도 피곤치 아니하리로다",
      "englishText": "but those who wait for the LORD will renew their strength. They will mount up with wings like eagles. They will run, and not be weary. They will walk, and not faint.",
      "emotions": [
        "지침",
        "기대"
      ],
      "tags": [
        "새힘",
        "기다림",
        "회복"
      ],
      "reflectionQuestion": "오늘 회복을 위해 가장 먼저 필요한 것은 무엇인가요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=isa&chap=40"
    },
    {
      "id": "JAS_1_19_20",
      "book": "야고보서",
      "chapter": 1,
      "verseStart": 19,
      "verseEnd": 20,
      "reference": "야고보서 1:19-20",
      "translation": "KRV",
      "text": "내 사랑하는 형제들아 너희가 알거니와 사람마다 듣기는 속히 하고 말하기는 더디 하며 성내기도 더디 하라 사람의 성내는 것이 하나님의 의를 이루지 못함이니라",
      "englishText": "So, then, my beloved brothers, let every man be swift to hear, slow to speak, and slow to anger; for the anger of man doesn’t produce the righteousness of God.",
      "emotions": [
        "분노",
        "혐오"
      ],
      "tags": [
        "분노",
        "경청",
        "절제",
        "말"
      ],
      "reflectionQuestion": "감정을 해치지 않게 표현하려면 어떤 문장이 좋을까요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=jas&chap=1"
    },
    {
      "id": "PRO_15_1",
      "book": "잠언",
      "chapter": 15,
      "verseStart": 1,
      "verseEnd": null,
      "reference": "잠언 15:1",
      "translation": "KRV",
      "text": "유순한 대답은 분노를 쉬게 하여도 과격한 말은 노를 격동하느니라",
      "englishText": "A gentle answer turns away wrath, but a harsh word stirs up anger.",
      "emotions": [
        "분노",
        "질투"
      ],
      "tags": [
        "온유",
        "말",
        "갈등"
      ],
      "reflectionQuestion": "사실과 요청을 차분하게 표현한다면 어떻게 말할 수 있을까요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=pro&chap=15"
    },
    {
      "id": "PSA_34_18",
      "book": "시편",
      "chapter": 34,
      "verseStart": 18,
      "verseEnd": null,
      "reference": "시편 34:18",
      "translation": "KRV",
      "text": "여호와는 마음이 상한 자에게 가까이 하시고 중심에 통회하는 자를 구원하시는도다",
      "englishText": "The LORD is near to those who have a broken heart, and saves those who have a crushed spirit.",
      "emotions": [
        "슬픔",
        "혐오",
        "질투"
      ],
      "tags": [
        "상한마음",
        "위로",
        "가까이함"
      ],
      "reflectionQuestion": "지금 가장 위로받고 싶은 마음은 무엇인가요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=psa&chap=34"
    },
    {
      "id": "JHN_14_27",
      "book": "요한복음",
      "chapter": 14,
      "verseStart": 27,
      "verseEnd": null,
      "reference": "요한복음 14:27",
      "translation": "KRV",
      "text": "평안을 너희에게 끼치노니 곧 나의 평안을 너희에게 주노라 내가 너희에게 주는 것은 세상이 주는 것 같지 아니하니라 너희는 마음에 근심도 말고 두려워하지도 말라",
      "englishText": "Peace I leave with you. My peace I give to you; not as the world gives, I give to you. Don’t let your heart be troubled, neither let it be fearful.",
      "emotions": [
        "슬픔",
        "불안"
      ],
      "tags": [
        "평안",
        "두려움",
        "마음"
      ],
      "reflectionQuestion": "지금 마음에 필요한 평안은 어떤 모습인가요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=jhn&chap=14"
    },
    {
      "id": "PRO_3_5_6",
      "book": "잠언",
      "chapter": 3,
      "verseStart": 5,
      "verseEnd": 6,
      "reference": "잠언 3:5-6",
      "translation": "KRV",
      "text": "너는 마음을 다하여 여호와를 의뢰하고 네 명철을 의지하지 말라 너는 범사에 그를 인정하라 그리하면 네 길을 지도하시리라",
      "englishText": "Trust in the LORD with all your heart, and don’t lean on your own understanding. In all your ways acknowledge him, and he will make your paths straight.",
      "emotions": [
        "복잡함",
        "불안"
      ],
      "tags": [
        "인도",
        "길",
        "신뢰",
        "선택"
      ],
      "reflectionQuestion": "오늘 당장 결론 내리지 않아도 되는 부분은 무엇인가요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=pro&chap=3"
    },
    {
      "id": "JAS_1_5",
      "book": "야고보서",
      "chapter": 1,
      "verseStart": 5,
      "verseEnd": null,
      "reference": "야고보서 1:5",
      "translation": "KRV",
      "text": "너희 중에 누구든지 지혜가 부족하거든 모든 사람에게 후히 주시고 꾸짖지 아니하시는 하나님께 구하라 그리하면 주시리라",
      "englishText": "But if any of you lacks wisdom, let him ask of God, who gives to all liberally and without reproach, and it will be given to him.",
      "emotions": [
        "복잡함"
      ],
      "tags": [
        "지혜",
        "분별",
        "구함"
      ],
      "reflectionQuestion": "결정 전에 더 확인해야 할 정보는 무엇인가요?",
      "englishTranslation": "WEB",
      "englishSource": "https://ebible.org/Scriptures/engwebp_vpl.zip",
      "koreanSource": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=jas&chap=1"
    },
